{
  "name": "clipwave-term",
  "version": "0.2.4",
  "description": "A terminal that is easier on the eyes, and talks back.",
  "main": "out/main/index.js",
  "author": "ilaiadaya",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dist": "electron-vite build && electron-builder --mac --dir",
    "dist:dmg": "electron-vite build && electron-builder --mac",
    "test:browser": "esbuild tests/browser-smoke.ts --bundle --platform=node --external:electron --external:@homebridge/node-pty-prebuilt-multiarch --outfile=.browser-smoke.cjs && electron .browser-smoke.cjs"
  },
  "dependencies": {
    "@homebridge/node-pty-prebuilt-multiarch": "^0.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-unicode11": "^0.8.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "electron": "^44.4.4",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "monaco-editor": "0.56.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.clipwave.term",
    "productName": "TerminAI",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "resources/**/*"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "identity": null
    },
    "fileAssociations": [
      {
        "ext": [
          "txt",
          "md",
          "json",
          "js",
          "jsx",
          "ts",
          "tsx",
          "py",
          "html",
          "css",
          "scss",
          "yaml",
          "yml",
          "toml",
          "sh",
          "c",
          "h",
          "cpp",
          "rs",
          "go",
          "xml",
          "csv",
          "log",
          "sql"
        ],
        "name": "Source code and text",
        "role": "Editor",
        "rank": "Alternate"
      }
    ]
  },
  "allowScripts": {
    "electron@44.4.4": true,
    "esbuild@0.21.5": true,
    "@homebridge/node-pty-prebuilt-multiarch@0.12.0": true
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
